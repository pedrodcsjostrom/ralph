#!/usr/bin/env python3
"""Runs ralph straight from this checkout; nothing needs installing.

Kept to syntax any Python 3 can parse, so an old interpreter gets a clear
message instead of a syntax error.
"""

import os
import sys

if sys.version_info < (3, 9):
    sys.stderr.write("ralph: Python 3.9 or newer is required, this is Python %d.%d\n" % sys.version_info[:2])
    sys.exit(1)

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "src"))

from ralph.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
