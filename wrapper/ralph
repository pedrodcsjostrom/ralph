#!/usr/bin/env python3
"""Runs the version of ralph this project is pinned to.

This is ralph's wrapper: a project commits it at its root, next to the
`.ralph` directory holding the pin. It reads the pin, makes sure that version
is in the per-user cache (fetching the tag from the public ralph repository
with plain git the first time) and hands over to it with the same arguments.
Nothing needs installing beyond Python 3.9 and git.

Kept to syntax any Python 3 can parse, so an old interpreter gets a clear
message instead of a syntax error, and to the standard library only.

It tells ralph which project to act on by setting RALPH_PROJECT to the
directory it lives in, so a command acts on this project wherever it is run.

Environment:
  RALPH_REPOSITORY  where versions are fetched from (default: the public repository)
  RALPH_CACHE       the per-user cache of fetched versions
                    (default: $XDG_CACHE_HOME/ralph, or ~/.cache/ralph)
"""

import os
import re
import shutil
import subprocess
import sys
import tempfile

REPOSITORY = "https://github.com/pedrodcsjostrom/ralph"
PIN = os.path.join(".ralph", "pin")
# A tag name that is also safe as a single directory name in the cache.
VERSION = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]*$")


class Failure(Exception):
    pass


def main(args):
    project = os.path.dirname(os.path.abspath(__file__))
    version = read_pin(os.path.join(project, PIN))
    path = os.path.join(cache_dir(), version)
    if not os.path.isdir(path):
        fetch(version, path)
    entry = os.path.join(path, "bin", "ralph")
    if not os.path.isfile(entry):
        raise Failure(
            "the cached ralph %s at %s has no bin/ralph; delete that directory to fetch it again" % (version, path)
        )
    os.environ["RALPH_PROJECT"] = project
    os.execv(sys.executable, [sys.executable, entry] + args)


def read_pin(path):
    try:
        with open(path) as f:
            version = f.read().strip()
    except FileNotFoundError:
        raise Failure("no pin at %s; this project is not set up to run ralph" % PIN) from None
    if not VERSION.match(version):
        raise Failure("the pin in %s is not a version name: %r" % (PIN, version))
    return version


def cache_dir():
    if os.environ.get("RALPH_CACHE"):
        return os.path.abspath(os.environ["RALPH_CACHE"])
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.join(os.path.abspath(base), "ralph")


def fetch(version, path):
    """Fetches the tag `version` into `path`, all or nothing.

    The version is assembled in a scratch directory beside `path` and renamed
    into place only once complete, so a failure or an interrupt never leaves a
    half-fetched version where a later run would take it for a cached one.
    """
    repository = os.environ.get("RALPH_REPOSITORY") or REPOSITORY
    tag = "refs/tags/" + version
    sys.stderr.write("ralph: fetching ralph %s\n" % version)
    sys.stderr.flush()

    found = git(["ls-remote", "--exit-code", "--tags", repository, tag])
    if found.returncode == 2:
        raise Failure("the pinned version %s does not exist in %s (pin: %s)" % (version, repository, PIN))
    if found.returncode != 0:
        raise fetch_failure(version, repository, found)

    cache = os.path.dirname(path)
    os.makedirs(cache, exist_ok=True)
    scratch = tempfile.mkdtemp(prefix=".fetch-%s-" % version, dir=cache)
    try:
        for command in (
            ["init", "--quiet", scratch],
            ["-C", scratch, "fetch", "--quiet", "--no-tags", "--depth", "1", repository, "%s:%s" % (tag, tag)],
            ["-C", scratch, "checkout", "--quiet", "--detach", tag],
        ):
            step = git(command)
            if step.returncode != 0:
                raise fetch_failure(version, repository, step)
        shutil.rmtree(os.path.join(scratch, ".git"))
        try:
            os.rename(scratch, path)
        except OSError:
            # Another run fetched the same version meanwhile; theirs is as good.
            if not os.path.isdir(path):
                raise
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def git(args):
    """Runs git without credentials or prompts, isolated from any enclosing repository."""
    env = dict(os.environ)
    for name in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY", "GIT_COMMON_DIR"):
        env.pop(name, None)
    env["GIT_TERMINAL_PROMPT"] = "0"
    command = ["git", "-c", "credential.helper=", "-c", "advice.detachedHead=false"] + args
    try:
        return subprocess.run(command, env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True)
    except FileNotFoundError:
        raise Failure("git is required to fetch ralph and was not found on PATH") from None


def fetch_failure(version, repository, proc):
    detail = "\n".join(("  " + line).rstrip() for line in proc.stderr.strip().splitlines())
    return Failure("could not fetch ralph %s from %s:\n%s" % (version, repository, detail))


if __name__ == "__main__":
    if sys.version_info < (3, 9):
        sys.stderr.write("ralph: Python 3.9 or newer is required, this is Python %d.%d\n" % sys.version_info[:2])
        sys.exit(1)
    try:
        main(sys.argv[1:])
    except Failure as failure:
        sys.stderr.write("ralph: %s\n" % failure)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
